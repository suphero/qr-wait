{
  "name": "plaj-sira",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "public" },
  "durable_objects": { "bindings": [
    { "name": "ROOM", "class_name": "Room" },
    { "name": "REGISTRY", "class_name": "Registry" }
  ] },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Registry"] }
  ],
  "observability": { "enabled": true }
  // Alt alan adlarını açmak için (alan adı Cloudflare'de olmalı, DNS'te proxied "*" kaydı gerekir):
  // "vars": { "BASE_DOMAIN": "belediyeplaj.com" },
  // "routes": [
  //   { "pattern": "belediyeplaj.com", "custom_domain": true },
  //   { "pattern": "*.belediyeplaj.com/*", "zone_name": "belediyeplaj.com" }
  // ]
}
