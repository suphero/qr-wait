{
  "name": "plaj-sira",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "public", "binding": "ASSETS" },
  "durable_objects": { "bindings": [
    { "name": "ROOM", "class_name": "Room" },
    { "name": "REGISTRY", "class_name": "Registry" }
  ] },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Registry"] }
  ],
  "observability": { "enabled": true },
  "workers_dev": true, // alan adı aktif olana kadar ve yedek erişim için açık kalsın
  // DNS'te "@" ve "*" için proxied AAAA 100:: yer tutucu kayıtları var
  "vars": { "BASE_DOMAIN": "sirangeldi.com" },
  "routes": [
    { "pattern": "sirangeldi.com/*", "zone_name": "sirangeldi.com" },
    { "pattern": "*.sirangeldi.com/*", "zone_name": "sirangeldi.com" }
  ]
}
