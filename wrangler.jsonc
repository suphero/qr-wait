{
  "name": "siran-geldi",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  // Arayüz web/ altında React + Vite; wrangler dev/deploy önce build alır ve dist/ sunulur
  "build": { "command": "npm run build", "watch_dir": "web" },
  "assets": { "directory": "dist", "binding": "ASSETS" },
  "durable_objects": { "bindings": [
    { "name": "ROOM", "class_name": "Room" },
    { "name": "REGISTRY", "class_name": "Registry" }
  ] },
  // Worker adı plaj-sira'dan siran-geldi'ye değişti: DO verisi eski Worker'dan taşındı
  "migrations": [
    { "tag": "v1", "transferred_classes": [
      { "from": "Room", "from_script": "plaj-sira", "to": "Room" },
      { "from": "Registry", "from_script": "plaj-sira", "to": "Registry" }
    ] }
  ],
  "observability": { "enabled": true },
  "workers_dev": true, // alan adı aktif olana kadar ve yedek erişim için açık kalsın
  // DNS'te "@" ve "*" için proxied AAAA 100:: yer tutucu kayıtları var
  // VAPID_PRIVATE_KEY secret olarak tutulur (wrangler secret put), .dev.vars'ta yerel kopyası var
  "vars": { "BASE_DOMAIN": "sirangeldi.com", "VAPID_PUBLIC_KEY": "BMnLrY7VHICel9RZSt62UEiLxZymXnHinntTM-oeV88iHlXTfWZjrtjTJjE_XSx4_q25hNs9TftLofwDaH-UHC4" },
  "routes": [
    { "pattern": "sirangeldi.com/*", "zone_name": "sirangeldi.com" },
    { "pattern": "*.sirangeldi.com/*", "zone_name": "sirangeldi.com" }
  ]
}
