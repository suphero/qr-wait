{
  "name": "siran-geldi",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "public", "binding": "ASSETS" },
  "durable_objects": { "bindings": [
    { "name": "ROOM", "class_name": "Room" },
    { "name": "REGISTRY", "class_name": "Registry" }
  ] },
  // Worker adı plaj-sira'dan siran-geldi'ye değişti: DO verisi eski Worker'dan taşındı
  "migrations": [
    { "tag": "v1", "transferred_classes": [
      { "from": "Room", "from_script": "plaj-sira", "to": "Room" },
      { "from": "Registry", "from_script": "plaj-sira", "to": "Registry" }
    ] }
  ],
  "observability": { "enabled": true },
  "workers_dev": true, // alan adı aktif olana kadar ve yedek erişim için açık kalsın
  // DNS'te "@" ve "*" için proxied AAAA 100:: yer tutucu kayıtları var
  "vars": { "BASE_DOMAIN": "sirangeldi.com" },
  "routes": [
    { "pattern": "sirangeldi.com/*", "zone_name": "sirangeldi.com" },
    { "pattern": "*.sirangeldi.com/*", "zone_name": "sirangeldi.com" }
  ]
}
